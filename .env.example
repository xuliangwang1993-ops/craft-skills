# 环境变量（全部可选，不写死任何密钥）
#
# 复制成 .env 后 `set -a; . ./.env; set +a`，或用 `make run` 时临时导出。
# 本仓库不含任何密钥；workbench 导入脚本读 WORKBENCH_KEY。

# --- 运行时 ---------------------------------------------------------------
# RUN_ID 不设则用 UTC 时间戳；SENTENCE 必填
# SENTENCE="给悉尼小锅米线（Slurp Slurp Noodle）做一支 30 秒宣传短视频，配中英字幕和三个社媒尺寸"

# --- 工具路径 -------------------------------------------------------------
# 本机有两套 ffmpeg：Alpine 版有 libx264/libass，iOS 版只有 VideoToolbox。
FFMPEG_CPU=/opt/ffmpeg/bin/ffmpeg
FFPROBE_BIN=/opt/ffmpeg/bin/ffprobe
FFMPEG_THREADS=6

# 交付编码器：libx264（CPU，默认）或 h264_videotoolbox（iOS 硬件，快 ~100x，但会锁死）
VIDEO_ENC=libx264

# --- 字体 -----------------------------------------------------------------
# 中文字体必须能显示简体；默认用仓库内 assets/fonts（OFL-1.1）
# FONT_ZH=assets/fonts/NotoSansSC-Bold.otf

# --- workbench 导入（第 7 站产物 → 卡片）-----------------------------------
WORKBENCH_BASE=http://127.0.0.1:8789
# WORKBENCH_KEY=sk-xc-...      # 网关 key；只在本地 shell 里，不进仓库

# --- 可选：Supabase（仅 workbench 自身需要，本流水线不直连）----------------
# SUPA_URL=
# SUPA_ANON_KEY=
