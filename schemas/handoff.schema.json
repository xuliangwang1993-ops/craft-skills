{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-skills/handoff.schema.json",
  "title": "handoff",
  "type": "object",
  "required": [
    "station",
    "inputs",
    "outputs",
    "tools",
    "elapsed_s",
    "exit_code"
  ],
  "properties": {
    "station": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ]
      }
    },
    "elapsed_s": {
      "type": "number"
    },
    "exit_code": {
      "type": "integer"
    }
  }
}
