{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-skills/menu.schema.json",
  "title": "menu",
  "type": "object",
  "required": [
    "items",
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name_zh",
          "name_en",
          "price_aud_inc_gst",
          "source_id",
          "status"
        ],
        "properties": {
          "name_zh": {
            "type": "string",
            "minLength": 1
          },
          "name_en": {
            "type": "string",
            "minLength": 1
          },
          "price_aud_inc_gst": {
            "type": "number"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "verified"
          }
        }
      }
    }
  }
}
