{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-skills/facts.schema.json",
  "title": "facts",
  "type": "object",
  "required": [
    "sources",
    "facts"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "url",
          "retrieved"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "retrieved": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "value",
          "source_id",
          "status"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "unverified",
              "conflict",
              "pending"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
